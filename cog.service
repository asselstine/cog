[Unit]
Description=Clanker Operations Gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/cog
Environment=HOME=/root
EnvironmentFile=/etc/cog/cog.env
ExecStart=/root/cog/scripts/start-service.sh
KillSignal=SIGINT
Restart=always
RestartSec=5s
TimeoutStopSec=45s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
